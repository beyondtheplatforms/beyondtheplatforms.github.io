{
  "BTP new article": {
    "scope": "markdown",
    "prefix": "btp-post",
    "description": "Front matter for a new Beyond The Platforms article",
    "body": [
      "---",
      "title: \"${1:Article title}\"",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "category: \"${2|Copilot Studio,AI Agents,Power Platform,Microsoft Fabric,Power BI,Automation|}\"",
      "tags: [\"${3:AI Agents}\", \"${4:Copilot Studio}\"]",
      "excerpt: \"${5:One or two sentences that sum up the article.}\"",
      "image: \"/assets/images/posts/${6:short-title}/cover.webp\"",
      "image_alt: \"${7:What the cover image shows}\"",
      "---",
      "",
      "$0"
    ]
  },
  "BTP image": {
    "scope": "markdown",
    "prefix": "btp-img",
    "description": "Image inside an article",
    "body": ["![${1:Describe the image}](/assets/images/posts/${2:short-title}/${3:image}.webp)"]
  },
  "BTP YouTube video": {
    "scope": "markdown",
    "prefix": "btp-yt",
    "description": "Clickable YouTube thumbnail",
    "body": [
      "<a href=\"https://www.youtube.com/watch?v=${1:VIDEO_ID}\" target=\"_blank\" rel=\"noopener\"><img class=\"youtube-thumb\" src=\"https://img.youtube.com/vi/${1:VIDEO_ID}/maxresdefault.jpg\" alt=\"${2:Video title}\" loading=\"lazy\"></a>"
    ]
  }
}
